model Product {
    id          String  @id @default(uuid())
    title       String
    description String?

    images ProductPicture[]

    price       Float  @default(0) // original/main price
    discountPct Float  @default(0) // e.g. 20 = 20%
    finalPrice  Float  @default(0) // computed and stored
    currency    String @default("USD")

    brandId String
    brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

    sizeId String
    size   Size   @relation(fields: [sizeId], references: [id], onDelete: Cascade)

    categoryId         String
    category           Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    catagory_hierarchy String[]

    condition String
    tags      String[]
    meterials String[]
    color     String

    care_instructions String[]

    allow_offer Boolean @default(false)

    return_window Int @default(0)

    charities ProductCharity[]
    donation_percent Float @default(0)

    isDeleted Boolean @default(false)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    favourites Favourite[]

    orderItems OrderItem[]

    viewers ProductView[]

    questions Question[]

    cartItems CartItem[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("products")
}

model ProductPicture {
    id        String  @id @default(uuid())
    url       String
    key       String
    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@map("product_pictures")
}

model ProductCharity {
    id String @id @default(uuid())

    isAnonymous Boolean @default(false)

    productId String
    product   Product @relation(fields: [productId], references: [id])

    charityId String
    charity   User   @relation(fields: [charityId], references: [id])

    createdAt DateTime @default(now())

    @@unique([productId, charityId])
    @@map("productCharities")
}

model Favourite {
    id String @id @default(uuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([userId, productId])
    @@map("favourites")
}

model CartGroup {
    id String @id @default(uuid())

    sellerId String
    seller   User   @relation("sellerGroupCarts", fields: [sellerId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation("myCarts", fields: [userId], references: [id], onDelete: Cascade)

    items CartItem[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([sellerId])
    @@map("carts")
}

model CartItem {
    id String @id @default(uuid())

    groupId String
    group   CartGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    extraDonation Float @default(0)

    quantity Int @default(1)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([groupId, productId])
    @@map("cart_items")
}

model ProductView {
  id        String   @id @default(uuid())
  productKey String
  userkey String
  productId String

  userId    String?  // null = guest
  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id])
  @@map("product_views")
}

model Question {
    id String @id @default(uuid())

    questionerId String
    questioner   User   @relation(fields: [questionerId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    question String
    answer String?

    createdAt DateTime @default(now())
    answeredAt DateTime?

    @@map("questions")
}

// Controls whether bundle discounts are enabled for a seller
model BundleDiscount {
  id        String                @id @default(uuid())
  sellerId  String                @unique
  seller    User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  enabled   Boolean               @default(false)
  tiers     BundleDiscountTier[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

// Each discount tier (e.g. "2 items → 10%", "3 items → 15%")
model BundleDiscountTier {
  id               String         @id @default(uuid())
  bundleDiscountId String
  bundleDiscount   BundleDiscount @relation(fields: [bundleDiscountId], references: [id], onDelete: Cascade)
  itemCount        Int            // minimum number of items to qualify (e.g. 2, 3, 5)
  discountPercent  Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([bundleDiscountId, itemCount]) // one tier per item count per seller
  @@index([bundleDiscountId])
}