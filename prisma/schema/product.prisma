model Product {
    id          String  @id @default(uuid())
    title       String
    description String?

    images ProductPicture[]

    price       Float  @default(0) // original/main price
    discountPct Float  @default(0) // e.g. 20 = 20%
    finalPrice  Float  @default(0) // computed and stored
    currency    String @default("USD")

    brandId String
    brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

    sizeId String
    size   Size   @relation(fields: [sizeId], references: [id], onDelete: Cascade)

    categoryId         String
    category           Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    catagory_hierarchy String[]

    condition String
    tags      String[]
    meterials String[]
    color     String

    care_instructions String[]

    stock Int @default(0)

    allow_offer Boolean @default(false)

    return_window Int @default(0)

    charities        ProductCharity[]
    donation_percent Float            @default(0)

    isDeleted Boolean @default(false)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    favourites Favourite[]

    orderItems OrderItem[]

    viewers ProductView[]

    questions Question[]

    cartItems CartItem[]

    chats ChatProdItem[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    weight_kg Float // in kg, for shipping cost calculation
    hight_cm  Float // in cm, for shipping cost calculation
    width_cm  Float // in cm, for shipping cost calculation
    length_cm Float // in cm, for shipping cost calculation

    offerItems OfferItem[]

    @@map("products")
}

model ProductPicture {
    id        String  @id @default(uuid())
    url       String
    key       String
    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@map("product_pictures")
}

model ProductCharity {
    id String @id @default(uuid())

    isAnonymous Boolean @default(false)

    productId String
    product   Product @relation(fields: [productId], references: [id])

    charityId String
    charity   User   @relation(fields: [charityId], references: [id])

    createdAt DateTime @default(now())

    @@unique([productId, charityId])
    @@map("productCharities")
}

model Favourite {
    id String @id @default(uuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([userId, productId])
    @@map("favourites")
}

model CartGroup {
    id String @id @default(uuid())

    sellerId String
    seller   User   @relation("sellerGroupCarts", fields: [sellerId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation("myCarts", fields: [userId], references: [id], onDelete: Cascade)

    items CartItem[]

    treeGiftCost       Float   @default(0)
    authenticationCost Float   @default(0)
    serviceFeeCost     Float   @default(2.30)
    shippingServiceId  String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    payments Payment[]

    @@unique([sellerId, userId])
    @@map("carts")
}

model CartItem {
    id String @id @default(uuid())

    groupId String
    group   CartGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    extraDonation          Float   @default(0)
    extraDonationAnonymous Boolean @default(false)

    quantity Int @default(1)

    charities CartDonationCharaties[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([groupId, productId])
    @@index([groupId, productId])
    @@index([productId, groupId])
    @@map("cart_items")
}

model CartDonationCharaties {
    id String @id @default(uuid())

    cartItemId String
    cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

    charityId String
    charity   User   @relation(fields: [charityId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([cartItemId, charityId])
    @@map("cart_donation_charities")
}

model Offer {
    id String @id @default(uuid())

    sellerId String
    seller   User   @relation("OffersForSeller", fields: [sellerId], references: [id], onDelete: Cascade)

    buyerId String
    buyer   User   @relation("OffersForBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

    actualPrice Float

    offeredPrice Float

    status OfferStatus @default(PENDING)

    sendByBuyer Boolean @default(true)

    actionAt DateTime? // when the offer was accepted/rejected/canceled

    message Message?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    offerItems OfferItem[]

    @@index([sellerId, buyerId])
    @@index([buyerId, sellerId])
    @@map("offers")
}

enum OfferStatus {
    PENDING
    ACCEPTED
    REJECTED
    CANCELED
}

model OfferItem {
    id String @id @default(uuid())

    offerId String
    offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    quantity Int @default(1)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([offerId, productId])
    @@index([productId, offerId])
    @@map("offer_items")
}

model ProductView {
    id         String @id @default(uuid())
    productKey String
    userkey    String
    productId  String

    userId String? // null = guest
    user   User?   @relation(fields: [userId], references: [id])

    createdAt DateTime @default(now())

    product Product @relation(fields: [productId], references: [id])

    @@map("product_views")
}

model Question {
    id String @id @default(uuid())

    questionerId String
    questioner   User   @relation(fields: [questionerId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    question String
    answer   String?

    createdAt  DateTime  @default(now())
    answeredAt DateTime?

    @@map("questions")
}

// Controls whether bundle discounts are enabled for a seller
model BundleDiscount {
    id        String               @id @default(uuid())
    sellerId  String               @unique
    seller    User                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
    enabled   Boolean              @default(false)
    tiers     BundleDiscountTier[]
    createdAt DateTime             @default(now())
    updatedAt DateTime             @updatedAt
}

// Each discount tier (e.g. "2 items → 10%", "3 items → 15%")
model BundleDiscountTier {
    id               String         @id @default(uuid())
    bundleDiscountId String
    bundleDiscount   BundleDiscount @relation(fields: [bundleDiscountId], references: [id], onDelete: Cascade)
    itemCount        Int // minimum number of items to qualify (e.g. 2, 3, 5)
    discountPercent  Int
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt

    @@unique([bundleDiscountId, itemCount]) // one tier per item count per seller
    @@index([bundleDiscountId])
}
