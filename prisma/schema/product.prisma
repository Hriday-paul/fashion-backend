model Product {
    id          String  @id @default(uuid())
    title       String
    description String?

    images ProductPicture[]

    price       Float  @default(0) // original/main price
    discountPct Float  @default(0) // e.g. 20 = 20%
    finalPrice  Float  @default(0) // computed and stored
    currency    String @default("USD")

    brandId String
    brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

    sizeId String
    size   Size   @relation(fields: [sizeId], references: [id], onDelete: Cascade)

    categoryId         String
    category           Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    catagory_hierarchy String[]

    condition String
    tags      String[]
    meterials String[]
    color     String

    care_instructions String[]

    allow_offer Boolean @default(false)

    return_window Int @default(0)

    charities ProductCharity[]
    donation_percent Float @default(0)

    isDeleted Boolean @default(false)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    favourites Favourite[]

    orderItems OrderItem[]

    viewers ProductView[]

    questions Question[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("products")
}

model ProductPicture {
    id        String  @id @default(uuid())
    url       String
    key       String
    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@map("product_pictures")
}

model ProductCharity {
    id String @id @default(uuid())

    isAnonymous Boolean @default(false)

    productId String
    product   Product @relation(fields: [productId], references: [id])

    charityId String
    charity   User   @relation(fields: [charityId], references: [id])

    createdAt DateTime @default(now())

    @@unique([productId, charityId])
    @@map("productCharities")
}

model Favourite {
    id String @id @default(uuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([userId, productId])
    @@map("favourites")
}

model ProductView {
  id        String   @id @default(uuid())
  productKey String
  userkey String
  productId String

  userId    String?  // null = guest
  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id])
  @@map("product_views")
}

model Question {
    id String @id @default(uuid())

    questionerId String
    questioner   User   @relation(fields: [questionerId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    question String
    answer String?

    createdAt DateTime @default(now())
    answeredAt DateTime?

    @@map("questions")
}