
model CharitableOrganization {
  id String @id @default(uuid())

  userId                    String @unique
  legalName                 String
  registrationNumber        String?
  registrationCountry       String
  registeredAddress         String?
  authorizedPersonName      String
  authorizedPersonRole      String
  registrationDocumentKey   String?
  authorizationDocumentKey  String?

  user User @relation( fields: [userId],references: [id],onDelete: Cascade)

  @@map("charitable_organizations")
}

model CharityShop {
  id String @id @default(uuid())

  userId                     String @unique
  shopName                   String
  operatorType               String
  legalBusinessName          String?
  businessRegistrationNumber String?
  registrationCountry        String?
  charityRegistrationNumber  String?
  charityRelationship        String?
  authorizationDocumentKey   String?
  registrationDocumentKey    String?

  user User @relation( fields: [userId],references: [id],onDelete: Cascade)

  @@map("charity_shops")
}

model EcoFriendlyStore {
  id String @id @default(uuid())

  userId                     String @unique
  storeName                  String
  legalBusinessName          String?
  businessRegistrationNumber String?
  registrationCountry        String?
  sustainabilityDescription  String
  certificationName          String?
  certificationIssuer        String?
  certificationNumber        String?
  certificationDocumentKey   String?

  user User @relation( fields: [userId],references: [id],onDelete: Cascade)

  @@map("eco_friendly_stores")
}

model Celebrity {
  id String @id @default(uuid())

  userId                  String @unique
  legalName               String
  publicName              String
  profession              String?
  officialWebsite         String?
  officialProfileUrls     String[] @default([])
  identityDocumentKey     String?
  publicIdentityEvidenceKey String?

  user User @relation( fields: [userId],references: [id],onDelete: Cascade)

  @@map("celebrities")
}

model Ambassador {
  id String @id @default(uuid())

  userId                   String @unique
  ambassadorType           String
  representedBrand         String?
  representedOrganization  String?
  authorizationDocumentKey String?
  agreementVersion         String?
  agreementAcceptedAt      DateTime?

  user User @relation( fields: [userId],references: [id],onDelete: Cascade)

  @@map("ambassadors")
}

model ProfessionalSeller {
  id String @id @default(uuid())

  userId                     String @unique
  legalBusinessName          String
  tradingName                String?
  businessType               String
  businessRegistrationNumber String?
  registrationCountry        String
  registeredAddress          String?
  registrationDocumentKey    String?
  taxIdentificationNumber    String?

  user User @relation( fields: [userId],references: [id],onDelete: Cascade)

  @@map("professional_sellers")
}
