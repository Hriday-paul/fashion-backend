model DirectDonation {
  id String @id @default(cuid())

  donorId String
  donor   User   @relation("donor", fields: [donorId], references: [id], onDelete: Restrict)

  charityId String
  charity   User   @relation("charity", fields: [charityId], references: [id], onDelete: Restrict)

  amount   Float @default(0)
  currency String  @default("USD")

  thanksMsg DonationThanksMSg?

  payment Payment?

  // anonymous donation
  isAnonymous Boolean @default(false)

  // donor message
  message String?

  donatedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([charityId])
  @@index([donorId])
}

enum WashedType {
  RECENT_WASHED
  WASHED
  UNWASHED
}

enum DonationType {
  SINGLE
  MULTIPLE
}

model ClothDonation {
  id            String                @id @default(uuid())
  photos        ClothDonationPhoto[]
  donorId       String
  donor         User                  @relation("clothDonateDonor", fields: [donorId], references: [id], onDelete: Cascade)

  charityId     String
  charity       User                  @relation("clothDonateCharity", fields: [charityId], references: [id], onDelete: Cascade)

  donationType  DonationType

  itemsCount String?

  itemTypes  String[]
  personTypes    String[]
  brands        String[]
  condition     String
  washedType    WashedType
  description   String?

  status        ClothDonationStatus @default(PENDING)

  thanksMsg DonationThanksMSg?

  shipment Shipment?

  hight_cm  Float @default(0)
  width_cm  Float @default(0)
  length_cm Float @default(0)
  weight_kg Float @default(0)

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt @default(now())

  @@index([donorId])
  @@index([charityId])
}

enum ClothDonationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

model ClothDonationPhoto{
  id            String                @id @default(uuid())
  donationId    String
  donation      ClothDonation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  url      String
  key      String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([donationId])
}

enum ThanksMessageType {
  SELL
  DIRECT
  EXTRA
  CLOTH
}

model DonationThanksMSg{
  id            String                @id @default(uuid())
  donorId       String
  donor         User                  @relation(fields: [donorId], references: [id], onDelete: Cascade)

  sellDonationId String? @unique
  sellDonation   SellDonation? @relation(fields: [sellDonationId], references: [id], onDelete: Cascade)

  directDonationId String? @unique
  directDonation   DirectDonation? @relation(fields: [directDonationId], references: [id], onDelete: Cascade)

  clothDonationId String? @unique
  clothDonation   ClothDonation? @relation(fields: [clothDonationId], references: [id], onDelete: Cascade)

  extraDonationId String? @unique
  extraDonation   ExtraDonation? @relation(fields: [extraDonationId], references: [id], onDelete: Cascade)

  message   String

  msgType ThanksMessageType

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt @default(now())

  @@index([donorId])
  @@index([sellDonationId])
  @@index([directDonationId])
  @@index([clothDonationId])
}