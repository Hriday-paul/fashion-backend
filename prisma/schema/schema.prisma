generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auth {
  id                String   @id @default(uuid())
  email             String
  password          String
  role              Role     @default(INDIVIDUAL_USER)
  status            Boolean  @default(true)
  isSocialLogin     Boolean  @default(false)
  isDeleted         Boolean  @default(false)
  isverified        Boolean  @default(false)
  otp               String?
  otp_status        Boolean  @default(true)
  expiredAt         DateTime @default(now())
  last_loginAt      DateTime @default(now())
  passwordChangedAt DateTime @default(now())

  approval_status Approval_Status @default(Pending)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auths")
}

model User {
  id       String  @id @default(uuid())
  fname    String
  lname    String?
  email    String  @unique
  userName String  @unique @default(uuid())
  phone    String?

  bio         String?
  description String? //about for carity

  // ---locations---
  country  String?
  state    String?
  city     String?
  address  String?
  zip_code String?

  //----social links-----
  instagram String?
  facebook  String?
  twitter   String?
  tiktok    String?
  website   String?

  support_email String? //for charity

  auth Auth?

  notification Boolean @default(true)

  fcmToken String?

  picture           ProfilePicture?
  account_documents AccountDocument[]
  mission           String?
  business_tags     String[]

  isOnline Boolean @default(false)

  lastOnlineAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  notificationReceivers Notification[] @relation("ReceivedNotifications")
  notificationSenders   Notification[] @relation("ActNotifications")

  sentMessages    Message[] @relation("sentMsgs")
  receiveMessages Message[] @relation("receiveMsgs")

  user1Chats Chat[] @relation("user1Chats")
  user2Chats Chat[] @relation("user2Chats")

  payments Payment[]

  products Product[]

  sellDonations    SellDonation[]
  productCharities ProductCharity[]

  assistentSellCharities AssistentSellCharity[]

  favouriteProducts Favourite[]

  //--------rating------------
  ratingsGiven    Rating[] @relation("RatingGiven")
  ratingsReceived Rating[] @relation("RatingReceived")

  // ---------return--------
  returnsAsBuyer  Return[] @relation("ReturnBuyer")
  returnsAsSeller Return[] @relation("ReturnSeller")

  // Users who follow me
  followers Follow[] @relation("UserFollowers")
  // Users I follow
  following Follow[] @relation("UserFollowing")

  // my donations to charaties
  donations         DirectDonation[] @relation("donor")
  // donation received as a charity
  donationsReceived DirectDonation[] @relation("charity")

  buyOrders        Order[] @relation("buyer")
  sellOrders    Order[] @relation("seller")

  productViews  ProductView[]

  prodQuestions Question[]

  billingAddress BillingDetails? @relation("asBuyer")
  sellerAddress BillingDetails? @relation("asSeller")

  offersAsBuyer  Offer[] @relation("OffersForBuyer")
  offersAsSeller Offer[] @relation("OffersForSeller")

  wallet Wallet?

  avgRating Float @default(0)

  vacationMode Boolean @default(false)

  stripeAccountId  String?
  stripeCustomerId String?
  charityGalleries CharityGallery[]

  carts CartGroup[] @relation("myCarts")
  sellerGroupCarts CartGroup[] @relation("sellerGroupCarts")

  assistentSells AssistentSell[]

  cartDonationCharities CartDonationCharaties[]

  badges UserBadge[]

  payoutRequests WalletPayout[]

  bundleDiscount    BundleDiscount?

  @@map("users")
}

model CharityGallery {
  id      String  @id @default(uuid())
  url     String
  key     String
  caption String?
  order   Int     @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("charity_gallery")
}

model ProfilePicture {
  id     String @id @default(uuid())
  url    String
  key    String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_pictures")
}

model AccountDocument {
  id     String @id @default(uuid())
  url    String
  key    String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_documents")
}

model BillingDetails {
  id        String  @id @default(uuid())
  userId    String? @unique
  user      User?   @relation("asBuyer",fields: [userId], references: [id], onDelete: Cascade) // for set on default to user

  sellerId  String? @unique
  seller    User?   @relation("asSeller", fields: [sellerId], references: [id], onDelete: Cascade) // for set on default to seller

  country   String
  countryCode String @default("US")
  full_name String? //user name
  address1  String
  address2  String?
  zip_code  String
  state     String
  email     String?
  city      String

  orders Order[] @relation("origin")
  ordersAsDestination Order[] @relation("destination")

  ordersAsAuthCenter Order[] @relation("auth")

  assistantSellOrigins AssistentSell[]

  contact String?

  @@map("billing_details")
}

enum Role {
  ADMIN
  INDIVIDUAL_USER
  CHARITABLE_ORGANIZATION
  CHARITY_SHOP
  ECO_FRIENDLY_STORE
  CELEBRITY
  AMBASSADOR
  PROFESSIONAL_SELLER
  ASSISTED_SELLER
}

enum Approval_Status {
  Pending
  Approved
  Rejected
}

model Notification {
  id       String  @id @default(uuid())
  actorId String?
  actor   User?   @relation("ActNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  receiverId String?
  receiver   User?   @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)

  entityId String?
  entityType NotificationEntityType?

  entityImgs String[] @default([])

  groupKeyId String?

  message   String
  fcmToken  String?
  type      NotificationType?
  title     String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
}

enum NotificationEntityType {
  PRODUCT
  OFFER
  ORDER
  MESSAGE
  USER
  DONATION
  RETURN
  BADGE
  WITHDRAWAL
  ASSISTED_SELL
}

enum NotificationType {
  //for product
  PRODUCT_LIKE
  PRICE_DROP
  SOLD_OUT

  //for offer
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  OFFER_CANCELED

  //for order
  ORDER_PLACED
  ORDER_STATUS_CHANGED
  ORDER_COMPLETED
  ORDER_ITEM_CANCELED
  ORDER_FAILED
  ORDER_AUTH_STATUS_CHANGED

  //for message
  MESSAGE_RECEIVED

  //for user
  FOLLOWED
  REVIEW_RECEIVED

  //for donation
  DONATION_RECEIVED

  //for return
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  RETURN_COMPLETED
  RETURN_STATUS_CHANGED
  RETURN_ITEM_CANCELED

  //Earned badge
  BADGE_EARNED

  //for withdrawal
  WITHDRAWAL_RECEIVED

  //assisted sell
  ASSISTED_SELL_REQUEESTED
  ASSISTED_SELL_STATUS_UPDATED
}

model Setting {
  id    String     @id @default(uuid())
  key   SettingKey @unique
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("settings")
}

enum SettingKey {
  terms
  privacy
  about
}
