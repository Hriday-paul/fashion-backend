generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auth {
  id                String   @id @default(uuid())
  email             String
  password          String
  role              Role     @default(INDIVIDUAL_USER)
  status            Boolean  @default(true)
  isDeleted         Boolean  @default(false)
  isverified        Boolean  @default(false)
  otp               String?
  otp_status        Boolean  @default(true)
  expiredAt         DateTime @default(now())
  last_loginAt      DateTime @default(now())
  passwordChangedAt DateTime @default(now())

  approval_status Approval_Status @default(Pending)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auths")
}

model User {
  id       String  @id @default(uuid())
  fname    String
  lname    String?
  email    String  @unique
  userName String  @unique @default(uuid())
  phone    String

  bio         String?
  description String? //about for carity

  // ---locations---
  country  String?
  state    String?
  city     String?
  address  String?
  zip_code String?

  //----social links-----
  instagram String?
  facebook  String?
  twitter   String?
  tiktok    String?
  website   String?

  support_email String? //for charity

  auth Auth?

  notification Boolean @default(true)

  fcmToken String?

  picture           ProfilePicture?
  account_documents AccountDocument[]
  mission           String?
  business_tags     String[]

  isOnline Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  notificationReceivers Notification[] @relation("ReceivedNotifications")
  notificationSenders   Notification[] @relation("SentNotifications")

  sentMessages    Message[] @relation("sentMsgs")
  receiveMessages Message[] @relation("receiveMsgs")

  chatGroups ChatParticipant[]

  payments Payment[]

  products Product[]

  sellDonations    SellDonation[]
  productCharities ProductCharity[]

  favouriteProducts Favourite[]

  //--------rating------------
  ratingsGiven    Rating[] @relation("RatingGiven")
  ratingsReceived Rating[] @relation("RatingReceived")

  // ---------return--------
  returnsAsBuyer  Return[] @relation("ReturnBuyer")
  returnsAsSeller Return[] @relation("ReturnSeller")

  // Users who follow me
  followers Follow[] @relation("UserFollowers")
  // Users I follow
  following Follow[] @relation("UserFollowing")

  // my donations to charaties
  donations         DirectDonation[] @relation("donor")
  // donation received as a charity
  donationsReceived DirectDonation[] @relation("charity")

  buyOrders        Order[] @relation("buyer")
  sellOrders    Order[] @relation("seller")

  productViews  ProductView[]

  prodQuestions Question[]

  billingAddress BillingDetails? @relation("asBuyer")
  sellerAddress BillingDetails? @relation("asSeller")

  wallet Wallet?

  avgRating Float @default(0)

  vacationMode Boolean @default(false)

  stripeAccountId  String?
  stripeCustomerId String?
  charityGalleries CharityGallery[]

  carts CartGroup[] @relation("myCarts")
  sellerGroupCarts CartGroup[] @relation("sellerGroupCarts")

  cartDonationCharities CartDonationCharaties[]

  bundleDiscount    BundleDiscount?

  @@map("users")
}

model CharityGallery {
  id      String  @id @default(uuid())
  url     String
  key     String
  caption String?
  order   Int     @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("charity_gallery")
}

model ProfilePicture {
  id     String @id @default(uuid())
  url    String
  key    String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_pictures")
}

model AccountDocument {
  id     String @id @default(uuid())
  url    String
  key    String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_documents")
}

model BillingDetails {
  id        String  @id @default(uuid())
  userId    String? @unique
  user      User?   @relation("asBuyer",fields: [userId], references: [id], onDelete: Cascade) // for set on default to user

  sellerId  String? @unique
  seller    User?   @relation("asSeller", fields: [sellerId], references: [id], onDelete: Cascade) // for set on default to seller

  country   String
  countryCode String @default("US")
  full_name String? //user name
  address1  String
  address2  String?
  zip_code  String
  state     String
  email     String?
  city      String

  orders Order[] @relation("origin")
  ordersAsDestination Order[] @relation("destination")

  contact String?

  @@map("billing_details")
}

enum Role {
  ADMIN
  INDIVIDUAL_USER
  CHARITABLE_ORGANIZATION
  CHARITY_SHOP
  ECO_FRIENDLY_STORE
  CELEBRITY
  AMBASSADOR
  PROFESSIONAL_SELLER
  ASSISTED_SELLER
}

enum Approval_Status {
  Pending
  Approved
  Rejected
}

model Notification {
  id       String  @id @default(uuid())
  senderId String?
  sender   User?   @relation("SentNotifications", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String?
  receiver   User?   @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)

  message   String
  fcmToken  String?
  type      NotificationType @default(Text)
  title     String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
}

enum NotificationType {
  Text
  Payment
  Cancelled
}

model Setting {
  id    String     @id @default(uuid())
  key   SettingKey @unique
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("settings")
}

enum SettingKey {
  terms
  privacy
  about
}
