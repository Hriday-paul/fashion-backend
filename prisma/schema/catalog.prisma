model Category {
    id   String @id @default(uuid())
    name String

    // Parent catalog (optional)
    parentId String?
    parent   Category?  @relation("CatalogHierarchy", fields: [parentId], references: [id])
    children Category[] @relation("CatalogHierarchy")

    products Product[]

    brands Brand[]
    sizes Size[]

    sizeGuide String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("categories")
}

model Brand {
    id   String @id @default(uuid())
    name String

    order Int @default(autoincrement())

    categoryId String
    category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    catagory_child_hierarchy String[]

    products Product[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("brands")
}

model Size {
    id   String @id @default(uuid())
    title String

    order Int @default(autoincrement())

    products Product[]

    categoryId String
    category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    catagory_child_hierarchy String[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("sizes")
}