model Category {
    id   String @id @default(uuid())
    name String

    // Parent catalog (optional)
    parentId String?
    parent   Category?  @relation("CatalogHierarchy", fields: [parentId], references: [id])
    children Category[] @relation("CatalogHierarchy")

    products Product[]

    brands BrandByCategory[]
    materials materialByCategory[]
    sizeCategoryHierarchyGroups SizeCategoryHierarchyGroup[]

    sizeGuide String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("categories")
}

model BrandByCategory {
    id         String @id @default(uuid())
    categoryId String
    brandId    String

    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("brand_by_category")
    @@index([categoryId, brandId])
    @@index([brandId, categoryId])
    @@unique([categoryId, brandId])
}

model Brand {
    id   String @id @default(uuid())
    name String

    order Int @default(autoincrement())

    brandByCategories BrandByCategory[]

    products Product[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("brands")
}

model materialByCategory {
    id         String @id @default(uuid())
    categoryId String
    materialId    String

    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    material    Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("material_by_category")
    @@index([categoryId, materialId])
    @@index([materialId, categoryId])
    @@unique([categoryId, materialId])
}

model Material {
    id   String @id @default(uuid())
    name String

    order Int @default(autoincrement())

    materialByCategories materialByCategory[]

    productMaterials ProductMaterial[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("materials")
}

model SizeCategoryHierarchyGroup {
    id         String @id @default(uuid())
    categoryId String
    sizeId    String

    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    size    Size    @relation(fields: [sizeId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("size_category_hierarchy_group")
    @@index([categoryId, sizeId])
    @@index([sizeId, categoryId])
    @@unique([categoryId, sizeId])
}

model Size {
    id   String @id @default(uuid())
    title String

    UK String?
    US String?
    EU String?

    order Int @default(autoincrement())

    products Product[]

    // Parent catalog (optional)
    parentId String?
    parent   Size?  @relation("SizeHierarchy", fields: [parentId], references: [id])
    children Size[] @relation("SizeHierarchy")

    sizeCategoryHierarchyGroups SizeCategoryHierarchyGroup[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("sizes")
}

model Keyword {
    id   String @id @default(uuid())
    name String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("keywords")
    @@index([name])
}