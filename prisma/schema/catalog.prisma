model Category {
    id   String @id @default(uuid())
    name String

    // Parent catalog (optional)
    parentId String?
    parent   Category?  @relation("CatalogHierarchy", fields: [parentId], references: [id])
    children Category[] @relation("CatalogHierarchy")

    products Product[]

    brands BrandByCategory[]
    sizes SizeByCategory[]

    sizeGuide String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("categories")
}

model BrandByCategory {
    id         String @id @default(uuid())
    categoryId String
    brandId    String

    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("brand_by_category")
    @@index([categoryId, brandId])
    @@index([brandId, categoryId])
    @@unique([categoryId, brandId])
}

model SizeByCategory {
    id         String @id @default(uuid())
    categoryId String
    sizeId    String

    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    size    Size    @relation(fields: [sizeId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("size_by_category")
    @@index([categoryId, sizeId])
    @@index([sizeId, categoryId])
    @@unique([categoryId, sizeId])
}

model Brand {
    id   String @id @default(uuid())
    name String

    order Int @default(autoincrement())

    brandByCategories BrandByCategory[]

    products Product[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("brands")
}

model Size {
    id   String @id @default(uuid())
    title String

    order Int @default(autoincrement())

    products Product[]

    sizeByCategories SizeByCategory[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("sizes")
}