model Category {
    id   String @id @default(uuid())
    name String

    // Parent catalog (optional)
    parentId String?
    parent   Category?  @relation("CatalogHierarchy", fields: [parentId], references: [id])
    children Category[] @relation("CatalogHierarchy")

    products Product[]

    brands BrandByCategory[]
    materials materialByCategory[]
    sizes SizeCategoryGroup[]

    suggestion ParcelSuggestion?

    sizeGuide String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("categories")
}

model BrandByCategory {
    id         String @id @default(uuid())
    categoryId String
    brandId    String

    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("brand_by_category")
    @@index([categoryId, brandId])
    @@index([brandId, categoryId])
    @@unique([categoryId, brandId])
}

model Brand {
    id   String @id @default(uuid())
    name String

    order Int @default(autoincrement())

    brandByCategories BrandByCategory[]

    products Product[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("brands")
}

model materialByCategory {
    id         String @id @default(uuid())
    categoryId String
    materialId    String

    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    material    Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("material_by_category")
    @@index([categoryId, materialId])
    @@index([materialId, categoryId])
    @@unique([categoryId, materialId])
}

model Material {
    id   String @id @default(uuid())
    name String

    order Int @default(autoincrement())

    materialByCategories materialByCategory[]

    productMaterials ProductMaterial[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("materials")
}

model SizeCategoryGroup {
    id         String @id @default(uuid())
    categoryId String
    sizeGroupId    String?
    letterSizeGroupId String?

    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    sizeGroup    SizeGroup?    @relation(fields: [sizeGroupId], references: [id], onDelete: Cascade)
    letterSizeGroup    LetterSizeGroup?    @relation(fields: [letterSizeGroupId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("size_category_group")
    @@index([categoryId, sizeGroupId])
    @@index([sizeGroupId, categoryId])
    @@index([letterSizeGroupId])
    @@unique([categoryId, sizeGroupId])
    @@unique([categoryId, letterSizeGroupId])
}

model SizeGroup{
    id   String @id @default(uuid())

    groupName String
    sizes Size[]

    sizeCategories SizeCategoryGroup[]
    

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@map("sizeGroups")
}

model LetterSizeGroup{
    id   String @id @default(uuid())

    groupName String
    sizes Size[]

    letterSizeCategoryGroup SizeCategoryGroup[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@map("letterSizeGroups")
}

model Size {
    id   String @id @default(uuid())
    title String //can be ignore or store US value

    UK String?
    US String?
    EU String?
    FR String?
    IT String?

    order Int @default(autoincrement())

    products Product[]

    groupId String?
    sizeGroup   SizeGroup?  @relation( fields: [groupId], references: [id], onDelete: Cascade)

    letterGroupId String?
    letterSizeGroup   LetterSizeGroup?  @relation( fields: [letterGroupId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("sizes")
    @@index(groupId)
}

model Keyword {
    id   String @id @default(uuid())
    name String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("keywords")
    @@index([name])
}

model ParcelSuggestion {
    id   String @id @default(uuid())
    weight_kg Float // in kg, for shipping cost calculation
    height_cm  Float // in cm, for shipping cost calculation
    width_cm  Float // in cm, for shipping cost calculation
    length_cm Float // in cm, for shipping cost calculation

    categoryId String @unique
    category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("parcel_suggestions")
    @@index([categoryId])
}