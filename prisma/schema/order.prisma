
enum OrderPricingSource {
    OFFER
    BUNDLE
}

model Order {
    id String @id @default(uuid())

    orderNumber String @unique

    rating Rating?

    buyerId String // buyer
    buyer   User   @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade) //buyer

    return Return?

    sellerId String
    seller   User   @relation("seller", fields: [sellerId], references: [id], onDelete: Restrict)

    items OrderItem[]

    payment Payment?

    status OrderStatus @default(PENDING)
    currentShipTo CurrentShipTo @default(BUYER)
    authStatus OrderAuthStatus @default(NOT_STARTED)

    //origin address
    originDetailsId String?
    originDetails BillingDetails? @relation("origin", fields: [originDetailsId], references: [id], onDelete: Restrict)

    //destination address
    billingId      String?
    billingDetails BillingDetails? @relation("destination",fields: [billingId], references: [id], onDelete: Restrict)

    itemsTotal    Float @default(0) // sum of all item prices
    totalDelivery Float @default(0) // delivery charges
    totalPrice    Float @default(0) // itemsTotal + total Delivery charge + treeCredit + serviceFee + authenticationFee == buyer total paid
    
    sellerItemsTotal Float @default(0) // sum of all items total prices - seller donation amount
    sellerTotal  Float @default(0) // sum of all items total prices - seller donation amount

    assistedSellCommission Float @default(0) // total assisted sell commission

    treeCredit    Float @default(0) // gifted for tree planner
    serviceFee    Float @default(0) // platform service fee
    authenticationFee Float @default(0) // authentication fee

    pricingSource OrderPricingSource @default(BUNDLE)
    offerId String?
    offer   Offer? @relation(fields: [offerId], references: [id], onDelete: Cascade)
    bundleDiscountPercent Float @default(0)

    extraDonation Float @default(0) // extra donation amount added by buyer

    allowedAuthentication Boolean @default(false)

    //step1 shipment
    shipmentId String @unique
    shipment   Shipment @relation("OrderShipments", fields: [shipmentId], references: [id], onDelete: Cascade)

    //step2 shipment, auth center to buyer
    authShipmentId String? @unique
    authShipment   Shipment? @relation("AuthOrderShipments", fields: [authShipmentId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    completedAt DateTime?
    cancelledAt DateTime?

    @@index([buyerId, sellerId])
    @@map("orders")
}

enum CurrentShipTo {
    AUTHENTICATION_CENTER
    BUYER
}

enum OrderStatus {
    PENDING
    SHIPPING
    COMPLETED
    CANCELLED
}

enum OrderAuthStatus {
    NOT_STARTED
    ITEM_RECEIVED
    IN_PROGRESS
    RESPONDED
}

enum OrderAuthResult {
    NOT_PROCESSED
    PASSED
    FAILED
}

model OrderItem {
    id String @id @default(uuid())

    orderId String
    order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

    quantity   Int
    weight     Float @default(0) // NEW: snapshot of product weight at order time
    unitPrice  Float // snapshot of price at time of order
    unitAllocatedPrice Float @default(0) // snapshot of price at time of order, after bundle discount & offer allocation
    sellerFinalUnitPrice Float @default(0) // snapshot of price at time of order, after bundle discount & offer allocation & seller donation allocation
    totalPrice Float // unitPrice * quantity

    assistedSellCommission Float @default(0)

    unitAuthFee Float @default(0)

    isCancelled Boolean @default(false)
    authResult OrderAuthResult @default(NOT_PROCESSED)

    buyerRequestCancel BuyerRequestCancelStatus @default(NOT_REQUESTED)
    cancellationRequestAt DateTime?

    returnItem ReturnItem?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    cancelledAt DateTime?

    extra_donation   Float          @default(0)
    sell_donation Float          @default(0)
    donations        SellDonation[]

    cancelledBy         CancelledBy?
    cancelReason        CancelReason?
    cancelReasonDetails String?
    // for attach photo or videos as reason
    
    cancelEvidences CancelOrderEvidence[]

    parcelItemId String?

    @@index([orderId]) // NEW
}

