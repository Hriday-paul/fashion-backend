model CancelOrderEvidence {
    id       String @id @default(uuid())
    itemId String
    item   OrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
    url      String
    key      String
    type     EvidenceType @default(IMAGE)
    createdAt DateTime @default(now())

    @@map("cancel_order_evidence")
    @@index([itemId])
}

model SellDonation {
    id String @id @default(uuid())

    amount  Float @default(0) //only item donation amount
    percent Float @default(0) //what actual percent received, split by other charaties

    extra_money Float @default(0)

    isAnonymous Boolean @default(false)

    total_amount Float @default(0) //adjusted extra + item donation

    status DonationStatus @default(PENDING)

    createdAt DateTime @default(now())

    orderItemId String
    orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

    charityId String
    charity   User   @relation(fields: [charityId], references: [id], onDelete: Restrict)

    thanksMessage DonationThanksMSg?

    donatedAt DateTime?

    @@map("sellItemMoneyDonations")
}

enum DonationStatus {
    PENDING
    PAID
    FAILED
}

enum CancelReason {
    CHANGED_MIND
    FOUND_BETTER_PRICE
    ORDERED_BY_MISTAKE
    ITEM_NO_LONGER_NEEDED
    DELIVERY_TOO_LONG
    FOUND_BETTER_PRODUCT
    WRONG_ITEM_SELECTED
    DUPLICATE_ORDER
    SHIPPING_COST_TOO_HIGH
    PAYMENT_ISSUE
    SELLER_UNRESPONSIVE

    OUT_OF_STOCK
    UNABLE_TO_FULFILL_IN_TIME
    PRICING_ERROR
    BUYER_UNREACHABLE
    SUSPECTED_FRAUD
    SHIPPING_ADDRESS_ISSUE
    LISTING_ERROR
    BUYER_REQUESTED
    DAMAGED_INVENTORY
    PAYMENT_NOT_VERIFIED

    OTHER
}

enum CancelledBy {
    SELLER
    BUYER
    SYSTEM
}

enum BuyerRequestCancelStatus {
    NOT_REQUESTED
    REQUESTED
    APPROVED
    REJECTED
}