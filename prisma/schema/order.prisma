model Order {
    id String @id @default(uuid())

    rating Rating?

    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt

    status    OrderStatus @default(PENDING)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    items     OrderItem[]

    return Return[]

    payment Payment?

    totalPrice Float

    @@index([userId])
    @@map("orders")
}

model OrderItem {
    id String @id @default(uuid())

    orderId String
    order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

    quantity   Int
    unitPrice  Float  // snapshot of price at time of order
    totalPrice Float  // unitPrice * quantity

    returnItems ReturnItem[]

    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt

    donation_percent Float @default(0)
    donation_amount Float @default(0)
    extra_donation Float @default(0)
    donations SellDonation[]

    @@index([orderId])
}

enum OrderStatus {
    PENDING
    CONFIRMED
    SHIPPED
    DELIVERED
    CANCELLED
}

model SellDonation {
    id String @id @default(uuid())

    amount  Float @default(0)
    percent Float @default(0)

    extra_money Float @default(0)

    isAnonymous Boolean @default(false)

    total_amount Float @default(0)

    status DonationStatus @default(PENDING)

    createdAt DateTime @default(now())

    orderItemId String
    orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

    charityId String
    charity   User   @relation(fields: [charityId], references: [id])

    @@map("sellItemMoneyDonations")
}

enum DonationStatus {
    PENDING
    PAID
    FAILED
}