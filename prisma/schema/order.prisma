// ─── NEW: groups all items from one seller within an order ───────────────────
model OrderSellerGroup {
    id String @id @default(uuid())

    orderId String
    order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

    sellerId String
    seller   User   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

    items OrderItem[]

    status    OrderStatus @default(PENDING)

    cancelledBy          CancelledBy?
    cancelReason   CancelReason?
    cancelReasonDetails   String?

    delivery OrderSellerDelivery?

    subtotal Float @default(0) // sum of all item totalPrices in this group

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([orderId, sellerId]) // one group per seller per order
    @@index([orderId])
    @@index([sellerId])
    @@map("order_seller_groups")
}

// ─── NEW: delivery charge per seller group ───────────────────────────────────
model OrderSellerDelivery {
    id String @id @default(uuid())

    sellerGroupId String            @unique
    sellerGroup   OrderSellerGroup  @relation(fields: [sellerGroupId], references: [id], onDelete: Cascade)

    totalItems     Int    @default(0)// snapshot: total item count at time of order
    totalWeight    Float  @default(0)// snapshot: total weight (kg) at time of order

    baseCharge     Float  @default(0)// charge calculated from count/weight
    discount       Float  @default(0)
    finalCharge    Float  @default(0)// baseCharge - discount

    status         DeliveryChargeStatus @default(UNPAID)

    paidAt    DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@map("order_seller_deliveries")
}

enum DeliveryChargeStatus {
    UNPAID
    PAID
    WAIVED
    REFUNDED
}

model Order {
    id String @id @default(uuid())

    rating Rating?

    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt

    userId String // buyer
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) //buyer

    // items     OrderItem[]

    return Return[]

    sellerGroups OrderSellerGroup[] // NEW

    payment Payment?

    billingId String?
    billingDetails BillingDetails? @relation(fields: [billingId], references: [id], onDelete: Restrict)

    itemsTotal        Float @default(0) // sum of all item prices
    totalDelivery     Float @default(0) // NEW: sum of all seller delivery charges
    totalPrice Float @default(0) // itemsTotal + total Delivery charge
    treeCredit Float @default(0) // gifted for tree planner

    @@index([userId])
    @@map("orders")
}

enum OrderStatus {
    PENDING
    CONFIRMED
    SHIPPED
    DELIVERED
    COMPLETED
    CANCELLED
}

model OrderItem {
    id String @id @default(uuid())

    // orderId String
    // order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

    // NEW: link to seller group
    sellerGroupId String
    sellerGroup   OrderSellerGroup @relation(fields: [sellerGroupId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

    quantity   Int
    weight     Float  @default(0) // NEW: snapshot of product weight at order time
    unitPrice  Float  // snapshot of price at time of order
    totalPrice Float  // unitPrice * quantity

    returnItem ReturnItem?

    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt

    donation_percent Float @default(0) //single item donation percent
    donation_amount Float @default(0) // total donation amount multiply by quantity
    extra_donation Float @default(0)
    donations SellDonation[]

    // @@index([orderId])
    @@index([sellerGroupId]) // NEW
}

model SellDonation {
    id String @id @default(uuid())

    amount  Float @default(0) //only item donation amount
    percent Float @default(0) //what actual percent received, split by other charaties

    extra_money Float @default(0)

    isAnonymous Boolean @default(false)

    total_amount Float @default(0) //adjusted extra + item donation

    status DonationStatus @default(PENDING)

    createdAt DateTime @default(now())

    orderItemId String
    orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

    charityId String
    charity   User   @relation(fields: [charityId], references: [id], onDelete: Restrict)

    donatedAt DateTime?

    @@map("sellItemMoneyDonations")
}

enum DonationStatus {
    PENDING
    PAID
    FAILED
}

enum CancelReason {
  CHANGED_MIND
  FOUND_BETTER_PRICE
  ORDERED_BY_MISTAKE
  ITEM_NO_LONGER_NEEDED
  DELIVERY_TOO_LONG
  FOUND_BETTER_PRODUCT
  WRONG_ITEM_SELECTED
  DUPLICATE_ORDER
  SHIPPING_COST_TOO_HIGH
  PAYMENT_ISSUE
  SELLER_UNRESPONSIVE

  OUT_OF_STOCK
  UNABLE_TO_FULFILL_IN_TIME
  PRICING_ERROR
  BUYER_UNREACHABLE
  SUSPECTED_FRAUD
  SHIPPING_ADDRESS_ISSUE
  LISTING_ERROR
  BUYER_REQUESTED
  DAMAGED_INVENTORY
  PAYMENT_NOT_VERIFIED

  OTHER
}

enum CancelledBy {
  SELLER
  BUYER
  SYSTEM
}