// ─── NEW: delivery charge per seller group ───────────────────────────────────
model OrderDeliveryCharge {
    id String @id @default(uuid())

    orderId String @unique
    order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

    totalItems  Int   @default(0) // snapshot: total item count at time of order
    totalWeight Float @default(0) // snapshot: total weight (kg) at time of order

    baseCharge  Float @default(0) // charge calculated from count/weight
    discount    Float @default(0)
    finalCharge Float @default(0) // baseCharge - discount

    status DeliveryChargeStatus @default(UNPAID)

    paidAt    DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@map("order_delivery_charges")
}

enum DeliveryChargeStatus {
    UNPAID
    PAID
    WAIVED
    REFUNDED
}

model Order {
    id String @id @default(uuid())

    orderNumber String @unique @default(cuid())

    rating Rating?

    buyerId String // buyer
    buyer   User   @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade) //buyer

    return Return[]

    sellerId String
    seller   User   @relation("seller", fields: [sellerId], references: [id], onDelete: Restrict)

    items OrderItem[]

    deliveryCharge OrderDeliveryCharge?

    payment Payment?

    status OrderStatus @default(PENDING)
    currentShipTo CurrentShipTo @default(BUYER)
    authStatus OrderAuthStatus @default(NOT_STARTED)

    originDetailsId String?
    originDetails BillingDetails? @relation("origin", fields: [originDetailsId], references: [id], onDelete: Restrict)

    billingId      String?
    billingDetails BillingDetails? @relation("destination",fields: [billingId], references: [id], onDelete: Restrict)

    itemsTotal    Float @default(0) // sum of all item prices
    totalDelivery Float @default(0) // NEW: sum of all seller delivery charges
    totalPrice    Float @default(0) // itemsTotal + total Delivery charge + treeCredit + serviceFee + authenticationFee
    
    sellerItemsTotal Float @default(0) // sum of all items total prices - seller donation amount
    sellerTotal  Float @default(0) // sum of all items total prices - seller donation amount - bundle discount

    treeCredit    Float @default(0) // gifted for tree planner
    serviceFee    Float @default(0) // platform service fee
    authenticationFee Float @default(0) // authentication fee

    bundleDiscountPercent Float @default(0)

    assistentSellId String? @unique
    assistentSell   AssistentSell? @relation(fields: [assistentSellId], references: [id], onDelete: Cascade)

    courier_service_id String
    shippingId String
    isLebelGenerated Boolean @default(false)
    lebelUrl String?

    parcelId String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    completedAt DateTime?
    cancelledAt DateTime?
    shippedAt DateTime?

    @@index([buyerId, sellerId])
    @@map("orders")
}

enum CurrentShipTo {
    AUTHENTICATION_CENTER
    BUYER
}

enum OrderStatus {
    PENDING
    SHIPPED
    OUT_FOR_DELIVERY
    DELIVERED
    COMPLETED
    CANCELLED
}

enum OrderAuthStatus {
    NOT_STARTED
    ITEM_RECEIVED
    IN_PROGRESS
    RESPONDED
}

enum OrderAuthResult {
    NOT_PROCESSED
    PASSED
    FAILED
}

model OrderItem {
    id String @id @default(uuid())

    orderId String
    order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

    quantity   Int
    weight     Float @default(0) // NEW: snapshot of product weight at order time
    unitPrice  Float // snapshot of price at time of order, after bundle discount
    totalPrice Float // unitPrice * quantity

    isCancelled Boolean @default(false)
    authResult OrderAuthResult @default(NOT_PROCESSED)

    buyerRequestCancel BuyerRequestCancelStatus @default(NOT_REQUESTED)
    cancellationRequestAt DateTime?

    returnItem ReturnItem?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    cancelledAt DateTime?

    extra_donation   Float          @default(0)
    donations        SellDonation[]

    cancelledBy         CancelledBy?
    cancelReason        CancelReason?
    cancelReasonDetails String?
    // for attach photo or videos as reason
    
    cancelEvidences CancelOrderEvidence[]

    parcelItemId String?

    @@index([orderId]) // NEW
}

