model Chat {
    id String @id @default(uuid())

    user1Id String
    user1   User   @relation("user1Chats", fields: [user1Id], references: [id], onDelete: Cascade)

    user2Id String
    user2   User   @relation("user2Chats", fields: [user2Id], references: [id], onDelete: Cascade)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    messages  Message[]

    items ChatItem[]

    order Order[]

    @@index([user1Id, user2Id])
    @@index([user2Id, user1Id])
    @@map("chatGroups")
}

model Message {
    id       String  @id @default(uuid())
    text     String?
    isSeen   Boolean @default(false)
    senderId String?
    sender   User?    @relation("sentMsgs", fields: [senderId], references: [id], onDelete: Cascade)

    receiverId String?
    receiver   User?   @relation("receiveMsgs", fields: [receiverId], references: [id], onDelete: Cascade)

    chatId String
    chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

    files FileMessage[]

    offerId String? @unique
    offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    SystemMessage SystemMessage?

    type MsgType @default(DIRECT)

    @@index([chatId, isSeen])
    @@index([chatId, receiverId, isSeen])
    @@index([receiverId, isSeen])
    @@index([offerId])
    @@index([senderId])
    @@map("messages")
}

enum MsgType{
    SYSTEM
    OFFER
    DIRECT
}

model SystemMessage {
    id String @id @default(uuid())

    title String
    text String

    msgForUserId String
    msgForUser User @relation(fields: [msgForUserId], references: [id], onDelete: Cascade)

    msgId String @unique
    msg Message @relation(fields: [msgId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("system_messages")
    @@index([msgForUserId])
}

model ChatItem {
    id String @id @default(uuid())

    chatId String
    chat   Chat  @relation(fields: [chatId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    quantity Int @default(1)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([chatId, productId])
    @@index([productId, chatId])
    @@map("chat_items")
}

model FileMessage {
    id        String  @id @default(uuid())
    key       String
    url       String
    title     String?
    messageId String
    message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
    type FileMessageType @default(IMAGE)

    @@map("document_messages")
}

enum FileMessageType {
    IMAGE
    DOCUMENT
}