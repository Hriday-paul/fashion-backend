model Payment {
  id     String  @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  total_amount Float @default(0) // total price
  paid_amount  Float @default(0) // how much customer paid

  seller_required_amount Float @default(0) // how much seller should receive
  seller_received_amount Float @default(0) // how much seller actually received

  status PaymentStatus @default(PENDING)

  stripe_status StripePaymentStatus @default(PENDING) // for track transfer

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  donationId String? @unique
  donation   DirectDonation? @relation(fields: [donationId], references: [id], onDelete: SetNull)

  paymentType PaymentType @default(ORDER)

  transactionId          String
  paymentIntentId        String?
  checkoutSessionId      String? // Stripe Checkout Session ID
  stripeTransferId       String? // Stripe Transfer ID (platform → seller)
  stripeRefundId         String? // Stripe Refund ID
  transferGroup          String? // ties charge → transfer (e.g. "order_xxx")
  sellerConnectAccountId String? // seller এর Stripe Connect account ID

  // ── Escrow timestamps ─────────────────────────────────────
  escrowedAt   DateTime? // buyer paid — money held
  releasedAt   DateTime? // return window passed — seller can withdraw
  refundedAt   DateTime? // buyer refunded
  reconciledAt DateTime? // last reconciliation check

  paidAt DateTime? // buyer paid
  cancelledAt DateTime? // buyer cancelled
  failedAt DateTime? // payment failed

  paymentData Json?

  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

enum PaymentType {
  ORDER
  DONATION
  SUBSCRIPTION
  SHIPMENT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSED
  FAILED
  CANCELLED
  REFUNDED
}

enum StripePaymentStatus {
  PENDING // checkout created, not paid yet
  ESCROWED // buyer paid, captured, held by platform
  RELEASED // return window passed, seller can withdraw
  REFUNDED // buyer refunded, money returned to buyer
}

model Refund {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount Float @default(0)

  status RefundStatus @default(PENDING)

  reason String?

  stripeRefundId String? // Stripe Refund ID

  refundedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
}

enum RefundStatus {
  PENDING
  SUCCESSED
  FAILED
}
