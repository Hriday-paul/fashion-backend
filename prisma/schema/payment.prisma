model Payment {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  total_amount Float @default(0) // total price
  paid_amount  Float @default(0) // how much customer paid

  seller_required_amount Float @default(0) // how much seller should receive
  seller_received_amount Float @default(0) // how much seller actually received

  status PaymentStatus @default(PENDING)

  stripe_status StripePaymentStatus @default(PENDING) // for track transfer

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  cartGroupId String?
  cartGroup   CartGroup? @relation(fields: [cartGroupId], references: [id], onDelete: SetNull)

  transactionId          String
  paymentIntentId        String?
  checkoutSessionId      String? // Stripe Checkout Session ID
  stripeTransferId       String? // Stripe Transfer ID (platform → seller)
  stripeRefundId         String? // Stripe Refund ID
  transferGroup          String? // ties charge → transfer (e.g. "order_xxx")
  sellerConnectAccountId String? // seller এর Stripe Connect account ID

  // ── Escrow timestamps ─────────────────────────────────────
  escrowedAt   DateTime? // buyer paid — money held
  releasedAt   DateTime? // return window passed — seller can withdraw
  refundedAt   DateTime? // buyer refunded
  reconciledAt DateTime? // last reconciliation check

  paymentData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSED
  FAILED
  CANCELLED //order cancelled
  REFUNDED // buyer refunded
}

enum StripePaymentStatus {
  PENDING // checkout created, not paid yet
  ESCROWED // buyer paid, captured, held by platform
  DELIVERED // delivery confirmed, pendingBalance started
  RELEASED // return window passed, seller can withdraw
  REFUNDED // buyer refunded
  FAILED // payment failed
  CANCELLED // order cancelled before delivery
  DISPUTED // dispute opened
}

model DirectDonation {
  id String @id @default(cuid())

  donorId String?
  donor   User?   @relation("donor", fields: [donorId], references: [id], onDelete: SetNull)

  charityId String
  charity   User   @relation("charity", fields: [charityId], references: [id], onDelete: Restrict)

  amount   Float @default(0)
  currency String  @default("USD")

  status DirectDonationStatus @default(PENDING)

  transactionId   String? @unique
  paymentIntentId String? @unique

  // anonymous donation
  isAnonymous Boolean @default(false)

  // donor message
  message String?

  donatedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([charityId])
  @@index([donorId])
  @@index([status])
}

enum DirectDonationStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}
