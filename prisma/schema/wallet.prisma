// =============================================================
// WALLET  ← seller wallet
// =============================================================
model Wallet {
  id                     String   @id @default(uuid())
  sellerId               String   @unique
  seller                 User     @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  // balance = withdrawable amount
  balance                Decimal  @default(0) @db.Decimal(12, 2)

  // currency               String   @default("USD")
  stripeConnectAccountId String?

  lastPayoutAt           DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
  @@index(sellerId)
}

// =============================================================
// WALLET TRANSACTION  ← audit log of every balance change
// =============================================================
model WalletTransaction {
  id        String   @id @default(uuid())

  walletId String
  wallet   Wallet   @relation(fields: [walletId], references: [id])

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  txType   WalletTransactionType
  direction TransactionDirection

  amount        Decimal @db.Decimal(12, 2)

  description   String?

  // Stripe references
  stripeBalanceTransactionId String?

  // Balance snapshot
  balanceBefore Decimal @db.Decimal(12, 2)
  balanceAfter  Decimal @db.Decimal(12, 2)

  metadata Json?

  // Reference to the entity that caused this transaction
  refId String?

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

enum WalletTransactionType {
  EARNING
  DONATION_RECEIVED
  PURCHASE
  DONATION_SENT
  REFUND
  WITHDRAWAL
  SHIPPING
  ADJUSTMENT
}

enum TransactionDirection {
  IN
  OUT
}